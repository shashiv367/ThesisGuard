# ThesisGuard Engine — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file (it is in .gitignore).

# -- Database ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/thesisguard

# -- JWT Authentication --------------------------------------------------------
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -- Optional: Hugging Face model cache location -------------------------------
# TRANSFORMERS_CACHE=./model_cache
