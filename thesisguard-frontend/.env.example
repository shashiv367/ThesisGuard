# ThesisGuard Frontend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file (it is in .gitignore).

# -- Backend API Base URL -------------------------------------------------------
# For local development (default used in App.jsx when this var is missing):
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# -- For production deployment, set to your deployed backend URL:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
