# ThesisGuard Frontend — .gitignore

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.cache/
.turbo/
.vite/

# Lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
